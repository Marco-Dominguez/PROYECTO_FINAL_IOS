    def Xform "PointLight"
    {
        float3 xformOp:translate = (-0.18102139, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "PointLight"
        {
            float3 color = (1, 0, 0.4265026)
            token info:id = "RealityKit.PointLight"
            float intensity = 2000
        }
    }

    def RealityKitTimeline "anim_1"
    {
        reorder nameChildren = ["Track", "Track2"]
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Spin"
            {
                string actionKind = "spin"
                int blendLayer = 400
                double duration = 3
                uniform token info:id = "F3166D55-A55D-4C27-AAE3-35A20DECCB73"
                float revolutions = 2
                double startTime = 0
                rel target = </luna/Moon>

                def RealityKitStruct "timingFunction"
                {
                    token type = "linear"
                }
            }
        }

        def RealityKitTrack "Track2"
        {
            def RealityKitAction "Orbit"
            {
                string actionKind = "orbit"
                float3 axis = (0, 0.5, 0.5)
                int blendLayer = 300
                double duration = 3
                uniform token info:id = "E817A6D6-8803-49B4-8A77-7C5D4BA43392"
                rel pivotEntity = </luna/Moon>
                float revolutions = -1
                double startTime = 0
                rel target = </luna/PointLight>
            }
        }
    }

    def RealityKitTimeline "rotacion_infinita"
    {
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Play_Timeline"

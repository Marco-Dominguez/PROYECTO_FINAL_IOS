    }

    def RealityKitComponent "RCP_BehaviorsContainer"
    {
        rel behaviors = [
            </luna/OnAddedToScene>,
            </luna/OnNotification>,
            </luna/OnNotification2>,
        ]
        uniform token info:id = "RCP.BehaviorsContainer"
    }

    def Preliminary_Behavior "OnAddedToScene"
    {
        rel actions = </luna/OnAddedToScene/Action>
        uniform bool exclusive
        rel triggers = </luna/OnAddedToScene/Trigger>

        def Preliminary_Trigger "Trigger"
        {
            rel affectedObjects = </luna>
            token info:id = "SceneTransition"
        }

        def Preliminary_Action "Action"
        {
            rel affectedObjects = </luna>
            rel animationLibraryKey = </luna/rotacion_infinita>
            rel animationLibraryKeyOverrideKey = </luna/OnAddedToScene/Trigger>
            token info:id = "PlayTimeline"
            int loops = 0
            int performCount = 1
            token type = "serial"
        }
    }

    def RealityKitComponent "InputTarget"
    {
        uniform token info:id = "RealityKit.InputTarget"
    }

    def RealityKitTimeline "saltito"
